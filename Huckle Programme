import numpy as np


# Linear polyene function
def Linear(n, a, b):
    L = np.zeros((n, n))

    for i in range(n):
        L[i, i] = a

    for i in range(n - 1):
        L[i, i + 1] = b
        L[i + 1, i] = b

    return L


# Cyclic polyene function
def Cyclic(n, a, b):
    Cy = np.zeros((n, n))

    for i in range(n):
        Cy[i, i] = a

    for i in range(n - 1):
        Cy[i, i + 1] = b
        Cy[i + 1, i] = b

    Cy[0, n - 1] = b
    Cy[n - 1, 0] = b

    return Cy


# Tetrahedron function
def Tetrahedron(a, b):
    T = np.full((4, 4), b)
    np.fill_diagonal(T, a)
    return T


# Cube function
def Cube(a, b):
    C = np.zeros((8, 8))

    bonds = [
        (0, 1), (0, 2), (0, 4),
        (2, 5), (2, 3),
        (1, 3), (1, 6),
        (5, 7), (7, 6), (3, 7),
        (5, 4), (6, 4)
    ]

    np.fill_diagonal(C, a)

    for i, j in bonds:
        C[i, j] = b
        C[j, i] = b

    return C


# Dodecahedron function
def Dodecahedron(a, b):
    D = np.zeros((20, 20))
    np.fill_diagonal(D, a)

    bonds = [
        (0, 1), (0, 2), (0, 3),
        (1, 4), (1, 5),
        (2, 6), (2, 7),
        (3, 8), (3, 9),
        (4, 6), (4, 10),
        (5, 8), (5, 11),
        (6, 12),
        (7, 9), (7, 13),
        (8, 14), (9, 15),
        (11, 10), (10, 16), (11, 17),
        (12, 13), (12, 16), (13, 18),
        (14, 17), (14, 15), (15, 18),
        (16, 19), (17, 19), (18, 19)
    ]

    for i, j in bonds:
        D[i, j] = b
        D[j, i] = b

    return D


# Linear acenes function
def Acenes(N, a, b):
    A = np.zeros((N, N))

    for i in range(N):
        A[i, i] = a

    for i in range(N - 2):
        A[i, i + 2] = b
        A[i + 2, i] = b

    for i in range(0, N - 1, 4):
        A[i, i + 1] = b
        A[i + 1, i] = b

    return A


# Counting degeneracy function
def degen(eigen):
    energy, counts = np.unique(np.round(eigen, 6), return_counts=True)

    e = list(energy)
    c = list(counts)

    for i in list(range(len(e))):
        print(f"Eigenvalue: {e[i]:.7f}  Degeneracy: {c[i]}")



